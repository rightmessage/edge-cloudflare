{
  "name": "@rightmessage/cloudflare",
  "version": "0.1.1",
  "description": "Flicker-free RightMessage personalization in front of your site on Cloudflare Workers",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rightmessage/edge-cloudflare.git"
  },
  "bugs": {
    "url": "https://github.com/rightmessage/edge-cloudflare/issues"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "verify:live": "node scripts/verify-live.mjs"
  },
  "dependencies": {
    "@rightmessage/edge": "^0.1.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20261003.1",
    "@types/node": "^22.0.0",
    "eslint": "^9.39.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.147.0"
  }
}
